# 1. Ignore everything by default (Fail-Safe Security)
*

# 2. Whitelist essential root files & scripts
!.gitignore
!SOUL.md
!config.yaml
!.env.example
!requirements.txt
!main.py
!init_employee.py

# 3. Whitelist core directories
!memories/
!memories/**
!skills/
!skills/**
!scripts/
!scripts/**
!templates/
!templates/**
!deploy/
!deploy/**
!instances/
!instances/**

# 4. Explicitly block sensitive artifacts even if inside whitelisted folders
*.env
*.env.*
*.pem
*.key
*.db
*.sqlite3
*.lock
*.log
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
instances/**/.env
instances/**/.env.*
instances/**/auth.json
instances/**/google_client_secret.json
instances/**/google_token.json
instances/**/config.yaml
instances/**/gateway_state.json
instances/**/channel_directory.json
instances/**/install_id
instances/**/*.pem
instances/**/*.key
instances/**/*.db
instances/**/*.sqlite*
instances/**/*.lock
instances/**/.usage.json
