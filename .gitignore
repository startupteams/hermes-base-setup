# 1. Ignore everything by default (Fail-Safe Security)
*

# 2. Whitelist essential root files & scripts
!.gitignore
!SOUL.md
!config.yaml
!.env.example
!requirements.txt
!main.py
!init_employee.py

# 3. Whitelist core directories
!profiles/
!profiles/**
!memories/
!memories/**
!skills/
!skills/**
!scripts/
!scripts/**
!templates/
!templates/**
!deploy/
!deploy/**

# 4. Explicitly block sensitive artifacts even if inside whitelisted folders
*.env
*.env.*
*.pem
*.key
*.db
*.sqlite3
*.lock
*.log
*token*
*secret*
*.ssh/
authorized_keys*
id_rsa*
id_ed25519*
*.p12
*.pfx
credentials*
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db

!profiles/dashboardtest/
